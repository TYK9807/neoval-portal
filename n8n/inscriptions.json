      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "const p = ($input.first().json.body) || $input.first().json;\nconst rec = p.record || {};\nconst old = p.old_record || {};\nlet action = 'ignore';\nif (p.type === 'INSERT') action = 'new_registration';\nelse if (p.type === 'UPDATE') {\n  if (rec.status === 'approved' && old.status !== 'approved') action = p.invite_link ? 'approved' : 'ignore';\n  else if (rec.status === 'rejected' && old.status !== 'rejected') action = 'rejected';\n}\nreturn [{ json: { action, pharmacyName: rec.pharmacy_name || 'Pharmacie', contactName: rec.contact_name || '', email: rec.email || '', phone: rec.phone || '', address: rec.address || '', inviteLink: p.invite_link || '' } }];"
      }
    },
