    {
      "id": "code1",
      "name": "Classifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "const p = ($input.first().json.body) || $input.first().json;\nconst rec = p.record || {};\nconst old = p.old_record || {};\nconst newStatus = rec.status || '';\nconst oldStatus = old.status || '';\nlet action = 'ignore';\nif (p.type === 'INSERT') action = 'new_order';\nelse if (p.type === 'UPDATE') {\n  if (newStatus === 'Confirmé' && oldStatus !== 'Confirmé') action = 'confirmed';\n  else if (newStatus === 'Livré' && oldStatus !== 'Livré') action = 'delivered';\n}\nconst total = Number(rec.total || 0);\nreturn [{ json: { action, orderId: rec.id || '', shortId: 'CMD-' + (rec.id||'').slice(0,8).toUpperCase(), placedBy: rec.placed_by || '', total, formattedTotal: total.toFixed(2).replace('.', ',') + ' MAD', newStatus } }];"
      }
    },
