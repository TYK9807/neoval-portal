        "jsCode": "const base = $('Classifier').first().json;\nconst resp = $input.first().json;\nconst users = Array.isArray(resp) ? resp : [resp];\nconst user = users[0] || {};\nreturn [{ json: { ...base, pharmacyName: user.name || 'Pharmacie', pharmacyEmail: user.email || '' } }];"
      }
